# Copy this file to .env and pass via:
# flutter run -d chrome -t lib/main_store.dart --dart-define-from-file=.env
#
# Leave SUPABASE_URL empty (or set DEMO_MODE=true) to run with interactive
# pre-seeded Ghana demo data (20 slipper styles, Kumasi/Accra delivery zones,
# simulated Mobile Money checkout, and full Admin controls).

DEMO_MODE=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
PAYSTACK_PUBLIC_KEY=
STORE_BASE_URL=https://priscyluxury.com
ADMIN_BASE_URL=https://admin.priscyluxury.com
